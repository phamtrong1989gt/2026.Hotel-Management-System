# ═══ MẪU CHUẨN .env.example của MỘT phần mềm nghiệp vụ (ConfigTemplates/env/app.env.example) — NGUỒN DUY NHẤT của bộ khoá ═══
# Mọi phần mềm nghiệp vụ (scaffold.appliesTo) phải có ĐỦ các khoá dưới đây ở .env.example của mình (kể cả dạng chú thích `# KHOÁ=`); khoá riêng của một phần mềm khai ở manifest.envExample.appOnly.
# Thêm / bỏ khoá: sửa MẪU này rồi chạy `node scripts/config-sync.mjs --sync` (bổ sung khoá còn thiếu vào từng phần mềm).
# PMS / pms / Property Management System chỉ có tác dụng khi SINH .env.example cho phần mềm MỚI.

# .env máy dev của PMS: MỘT tệp duy nhất, chế độ Linked (đăng nhập qua SSO), dùng cho cả dev-stack lẫn chạy trực tiếp (F5). Không commit (đã .gitignore).
# Dòng # ngay trên mỗi khoá giải thích khoá đó. Hai gạch dưới (__) = dấu hai chấm (:) trong appsettings. Biến môi trường thật luôn thắng tệp này.

# ── CSDL (ConnectionStrings, DataSources) ──

# Chuỗi kết nối CSDL của PMS (A06.PMS.OPER).
ConnectionStrings__OperationalConnection=Data Source=<máy-chủ-SQL>;Initial Catalog=A06.PMS.OPER;User ID=<tài-khoản-SQL>;Password=<mật-khẩu-SQL>;Max Pool Size=200;TrustServerCertificate=true;

# Chuỗi kết nối nguồn dữ liệu phụ có mã DATA. Chưa có nghiệp vụ nào dùng, chỉ là khung có sẵn. Để TRỐNG = không khai nguồn này (bỏ qua, không khởi tạo context).
DataSources__DATA__Connection=

# Loại của nguồn DATA (Data). Đi kèm dòng trên.
DataSources__DATA__Model=Data

# ── API (ApiSettings): token đăng nhập, địa chỉ giao diện, tích hợp ──

# Key ký token đăng nhập của PMS (và băm thẻ làm mới lưu trong CSDL). Tối thiểu 32 ký tự, mỗi phần mềm một key khác nhau.
# Đổi key = mọi người dùng phải đăng nhập lại.
ApiSettings__TokenKey=

# Tên nơi phát hành ghi trong token của PMS. API kiểm đúng tên này; mỗi phần mềm một tên khác nhau để token không dùng chéo được.
ApiSettings__TokenIssuer=pms-api

# Tên đối tượng nhận ghi trong token của PMS. API kiểm đúng tên này; mỗi phần mềm một tên khác nhau để token không dùng chéo được.
ApiSettings__TokenAudience=pms-client

# Địa chỉ web (origin) của giao diện được phép gọi API (CORS). Phải đúng http/https và cổng của giao diện.
ApiSettings__UseCors=https://localhost:<cổng-API>,https://localhost:<cổng-giao-diện>

# Địa chỉ web của giao diện, dùng dựng link gửi cho người dùng (vd đặt lại mật khẩu). Thường giống dòng trên.
ApiSettings__PublicWebUrl=https://localhost:<cổng-giao-diện>

# ── Mã hoá (Crypto, BaseSettings) ──

# Key riêng (RSA) của API. Giao diện mã hoá dữ liệu gửi lên bằng key công khai tương ứng, API dùng key này để giải mã.
# Đổi key này thì phải đổi luôn key công khai ở giao diện: src/Apps/PMS/FE/src/environments/environment*.ts.
Crypto__Admin__PrivateKey=

# Key mã hoá các cột bí mật trong CSDL: bí mật 2FA, key đối tác API, mật khẩu nhà cung cấp gửi tin, tài khoản / mật khẩu / RTSP của camera.
# Mất key này = không giải mã được dữ liệu đã mã hoá. Mỗi phần mềm một key riêng.
Crypto__PartnerKeyEncryptionKey=

# Key mã hoá CŨ, chỉ để giải mã dữ liệu đã mã hoá từ trước. Đang trùng với key của SSO.
# CHƯA bỏ được: đã thử giải mã, 157 giá trị trong CSDL (thông tin đăng nhập camera, key đối tác API) chỉ mở được bằng key này. Phải mã hoá lại bằng key
# mới rồi mới bỏ.

# Key dùng để băm mã OTP trước khi lưu vào CSDL (lộ CSDL cũng không đọc được OTP). Tối thiểu 16 ký tự, bắt buộc có.
# Đổi key = các mã OTP đang chờ hết hiệu lực.
BaseSettings__EncryptionKey=

# ── Đăng nhập qua SSO (Deployment) ──

# Chế độ chạy: Linked (đăng nhập và phân quyền qua SSO, chế độ chạy thật) · Standalone (tự đăng nhập) · SsoServer (máy chủ SSO).
Deployment__Mode=Linked

# Id của PMS đã đăng ký ở SSO (số do SSO cấp).
Deployment__AppId=<AppId-do-SSO-cấp>

# Tiền tố tên cookie của PMS, để cookie các phần mềm không đè nhau khi dùng chung một tên miền.
Deployment__CookiePrefix=PMS

# Thẻ làm mới gửi qua cookie (Cookie). Bắt buộc ở chế độ Linked vì đăng nhập SSO là chuyển hướng trình duyệt.
AuthorizeSettings__TokenSettings__RefreshTransport=Cookie

# Địa chỉ gốc của SSO. Khai đúng từng ký tự như SsoProvider__Issuer bên SSO.
Deployment__SsoClient__Issuer=https://localhost:5101

# Mã client của PMS đã đăng ký ở SSO (màn Client IdP).
Deployment__SsoClient__ClientId=<mã-client-đã-đăng-ký-ở-SSO>

# Tên (kid) của khoá riêng ở dòng dưới. Khoá công khai tương ứng đã đăng ký ở SSO.
Deployment__SsoClient__KeyId=<kid-của-khoá-riêng>

# Khoá riêng (RSA) của PMS: ký yêu cầu đăng nhập SSO và ký token mỗi lần kéo người dùng, quyền, danh mục từ SSO. SSO kiểm bằng khoá công khai đã đăng
# ký.
Deployment__SsoClient__PrivateKey=

# Địa chỉ API của phần mềm mà SSO chuyển người dùng về sau khi đăng nhập. Phải trùng địa chỉ đã đăng ký ở SSO.
Deployment__SsoClient__RedirectUri=https://localhost:<cổng-API>/api/identity/Account/SsoCallback

# Trang giao diện mà SSO chuyển người dùng về sau khi đăng xuất. Phải trùng địa chỉ đã đăng ký ở SSO.
Deployment__SsoClient__PostLogoutRedirectUri=https://localhost:<cổng-giao-diện>/logged-out

# Trang giao diện mở sau khi đăng nhập xong, khi không có địa chỉ quay về riêng.
Deployment__SsoClient__DefaultReturnUrl=https://localhost:<cổng-giao-diện>/sso-return

# Cách kéo người dùng, quyền, danh mục từ SSO: Apply = ghi vào CSDL · DryRun = chỉ thử, không ghi.
Deployment__SsoSync__Mode=Apply

# ── File API và Kho lưu trữ (FileServer, StorageExplorer) ──

# true = dùng File API (mặc định đã bật). false = tắt File API.
FileServer__Enabled=true

# Địa chỉ File API. Có giá trị = lưu tệp qua File API; trống = báo chưa cấu hình File API (ảnh, tệp không lưu được).
# Đang trống nên chạy F5 sẽ bị vậy. Chạy bằng stack dev-stack thì dùng bản trong .local (https://localhost:5601/v1/pms/) nên vẫn chạy được.
FileServer__BaseUrl=https://localhost:5601/v1/pms/

# Mật khẩu để PMS gọi File API. Phải khớp với File API; chỉ có tác dụng khi FileServer__BaseUrl có giá trị.
FileServer__InternalToken=

# Bật màn Kho lưu trữ (xem tệp đang lưu trên File API).
StorageExplorer__Enabled=true

# Mã của nguồn kho tệp hiển thị trên màn Kho lưu trữ.
StorageExplorer__Sources__0__Code=files

# Tên hiển thị của nguồn kho tệp.
StorageExplorer__Sources__0__Name=Kho tệp (File API)

# Loại nguồn: FileService = lấy tệp qua File API.
StorageExplorer__Sources__0__Kind=FileService

# true = bật nguồn kho tệp này.
StorageExplorer__Sources__0__Enabled=true

# ── Đăng nhập: OTP, captcha, email (AuthorizeSettings, CommunicationSecrets) ──

# Fake = OTP giả, không gửi email / tin nhắn thật.
AuthorizeSettings__OtpSettings__DeliveryMode=Fake

# Tên hiện trong ứng dụng xác thực 2FA (Authenticator).
AuthorizeSettings__OtpSettings__TwoFactorIssuer=PMS_Dev

# false = tắt captcha ở máy dev. Muốn bật lại: xoá dòng này hoặc đặt true.
AuthorizeSettings__CaptchaSettings__Enabled=false

# Key reCAPTCHA của Google. Chỉ dùng khi chạy Standalone và bật captcha (máy dev đang tắt).
AuthorizeSettings__CaptchaSettings__SecretKey=

# Mật khẩu ứng dụng Gmail (do Google cấp, không phải mật khẩu đăng nhập Google) để gửi OTP qua email.
# Đang trống = chưa gửi được email thật.
CommunicationSecrets__GMAIL_SMTP_PRIMARY__AppPassword=

# ── Chạy: môi trường, địa chỉ lắng nghe, log (ASPNETCORE_*, LogStorage) ──

# Môi trường chạy của ASP.NET: Development = máy dev.
ASPNETCORE_ENVIRONMENT=Development

# Địa chỉ https mà API PMS lắng nghe (theo bảng cổng dev, docs/deploy/bang-cong-dev.md).
ASPNETCORE_URLS=https://localhost:<cổng-API>

# Thư mục lưu file log (Serilog). KHÔNG khai / để TRỐNG (null) = MẶC ĐỊNH CŨ: thư mục `logs` ngay trong thư mục phần mềm (cạnh DLL) — tài khoản app pool cần quyền ghi ở đó (không ghi được thì app vẫn chạy nhưng KHÔNG có log).
# Muốn đưa log ra ngoài thư mục phần mềm: đường dẫn tuyệt đối thì dùng nguyên (vd D:\Logs); tương đối thì tính từ thư mục chạy API. Máy sinh mã tự tách thư mục riêng cho từng phần mềm (<gốc>\<mã>) khi khoá này được khai.
# Khoá LUÔN có mặt ở đây (luật phần mềm mới, D-CORE-174) để mọi phần mềm — kể cả phần mềm mới — có chỗ cấu hình; dạng chú thích = null.
# LogStorage__Root=D:\Logs
