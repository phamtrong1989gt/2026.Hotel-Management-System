// Cảnh báo chủ động — tự kiểm tra định kỳ các dấu hiệu bất thường rồi gửi thư cho quản trị và ghi nhật ký an toàn.
// Đổi ở đây không cần khởi động lại API, áp dụng từ lượt kiểm tra kế tiếp.
{
  // Thiết lập chung — công tắc tổng, chu kỳ kiểm tra, gửi thư và người nhận.
  "Alerts": {
    // Bật cảnh báo chủ động — Tắt: không kiểm tra theo lịch, không phát cảnh báo nào.
    "Enabled": true,
    // Chu kỳ kiểm tra (phút) — bao lâu kiểm tra tất cả các luật một lượt (từ 1 đến 60).
    "IntervalMinutes": 5,
    // Gửi thư cảnh báo — Bật: gửi thư tới "Email nhận cảnh báo". Tắt: chỉ ghi nhật ký (dùng khi chạy thử).
    "SendEmail": true,
    // Email nhận cảnh báo — mỗi dòng một địa chỉ. Để trống: KHÔNG gửi thư nào, cảnh báo chỉ còn trong nhật ký.
    // Thư đi qua phân hệ Gửi tin; chế độ gửi OTP đang để Fake thì thư chỉ giả lập, không tới hộp thư thật.
    "NotifyEmails": [],
    // Luật cảnh báo — mỗi mục một luật (sửa dạng JSON): Key mã luật · Enabled bật / tắt · Threshold ngưỡng · WindowMinutes cửa sổ (phút) · CooldownMinutes nghỉ (phút).
    // Đã báo thì chờ hết thời gian nghỉ mới báo lại (0 = mỗi lượt). Luật không có mục dùng mặc định; đã có mục thì ghi đủ 5 trường (thiếu → ngưỡng 0, cửa sổ 15, nghỉ 60).
    "Rules": [
      {
        // Mã luật — sai mật khẩu liên tiếp từ một IP (dấu hiệu dò mật khẩu); nghỉ tính riêng từng IP. Không đổi mã này.
        "Key": "login-failed-burst",
        "Enabled": true,
        // Ngưỡng (lần sai) — số lần sai mật khẩu từ cùng một IP trong cửa sổ quan sát thì báo.
        "Threshold": 10,
        "WindowMinutes": 15,
        "CooldownMinutes": 60
      },
      {
        // Mã luật — đăng nhập thành công từ IP mà tài khoản chưa dùng trong 30 ngày trước; nghỉ tính theo cặp tài khoản + IP. Không đổi mã này.
        "Key": "login-unusual",
        "Enabled": true,
        // Ngưỡng (lần đăng nhập) — số lần từ IP lạ trong cửa sổ quan sát thì báo; 1 = báo ngay lần đầu.
        "Threshold": 1,
        "WindowMinutes": 60,
        "CooldownMinutes": 120
      },
      {
        // Mã luật — số lỗi máy chủ tăng bất thường (thường do chức năng vừa hỏng sau khi triển khai). Không đổi mã này.
        "Key": "server-errors",
        "Enabled": true,
        // Ngưỡng (số lỗi) — đạt ngưỡng trong khung đếm thì báo; gấp đôi ngưỡng là mức nghiêm trọng.
        "Threshold": 20,
        // Cửa sổ quan sát (phút) — chỉ có hai khung: 1–5 đếm 5 phút gần nhất, lớn hơn 5 đếm 60 phút gần nhất.
        "WindowMinutes": 5,
        "CooldownMinutes": 30
      },
      {
        // Mã luật — ổ đĩa chứa thư mục của phần mềm (ảnh / video, tài liệu, nhật ký) sắp đầy; nghỉ tính theo thư mục. Không đổi mã này.
        "Key": "disk-low",
        "Enabled": true,
        // Ngưỡng (% còn trống) — ổ còn trống từ bấy nhiêu phần trăm trở xuống thì báo; còn nửa mức này là nghiêm trọng.
        "Threshold": 10,
        // Cửa sổ quan sát — không dùng (luật đọc dung lượng trống ngay lúc kiểm tra).
        "WindowMinutes": 0,
        "CooldownMinutes": 360
      },
      {
        // Mã luật — việc chạy ngầm (vd thu số liệu sử dụng) thất bại ở lượt gần nhất; nghỉ tính theo từng việc. Không đổi mã này.
        "Key": "job-failed",
        "Enabled": true,
        // Ngưỡng (lượt thất bại) — số lượt thất bại từ khi API khởi động đạt ngưỡng thì báo; 1 = báo ngay lần đầu.
        "Threshold": 1,
        // Cửa sổ quan sát — không dùng (luật đọc trạng thái lượt chạy gần nhất).
        "WindowMinutes": 0,
        "CooldownMinutes": 180
      }
    ]
  }
}
