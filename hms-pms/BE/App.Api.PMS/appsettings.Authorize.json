// Đăng nhập & an toàn tài khoản — mật khẩu, khóa khi nhập sai, tự khóa màn hình, thẻ đăng nhập, OTP, passkey, reCAPTCHA.
// Đặt sai có thể làm KHÔNG AI đăng nhập được; hầu hết thay đổi cần khởi động lại API. Khóa bí mật đặt ở .env, không ghi ở đây.
{
  // Mật khẩu & khóa đăng nhập — khóa tài khoản khi nhập sai, hạn dùng mật khẩu, chống dùng lại mật khẩu cũ.
  "AuthorizeSettings": {
    // Khóa tài khoản khi nhập sai mật khẩu — Bật: sai đủ "Số lần sai cho phép" trong ngày thì khóa. Tắt: không khóa — không nên, kẻ dò mật khẩu thử không giới hạn.
    "CheckLoginWrongPassword": true,
    // Số lần sai cho phép — nhập sai đến lần thứ bấy nhiêu trong ngày thì khóa tài khoản (0 hoặc 1 = sai một lần là khóa).
    "MaxNumberWrongPasswords": 5,
    // Thời gian khóa (phút) — hết thì tài khoản tự mở. 0 = khóa hẳn tới khi quản trị mở — không nên: kẻ xấu cố nhập sai là khóa được tài khoản người khác.
    "LockLoginInMinutes": 15,
    // Số lần sai mã xác thực hai lớp — sai mã 6 số (hoặc mã dự phòng) đến lần thứ bấy nhiêu thì khóa tạm; nên đặt chặt.
    // Khóa theo "Thời gian khóa (phút)" (ô đó để 0 thì 15 phút). Sai rải rác đủ gấp đôi số này trong 24 giờ cũng bị khóa.
    "MaxTwoFactorWrongCodes": 5,
    // Khóa tăng dần khi sai mã hai lớp, tối đa (phút) — mỗi lần khóa liên tiếp dài gấp đôi lần trước, không quá số này. 0 = không tăng.
    // Về mức đầu khi nhập đúng mã, sau 24 giờ không bị khóa lại, hoặc khi API khởi động lại.
    "MaxTwoFactorLockMinutes": 1440,
    // Hạn dùng mật khẩu (ngày) — quá số ngày kể từ lần đổi gần nhất thì lần đăng nhập kế tiếp phải đổi. 0 = không hết hạn.
    "PasswordExpiryDays": 90,
    // Số mật khẩu cũ không được dùng lại — không được trùng một trong bấy nhiêu mật khẩu gần nhất. 0 = không kiểm.
    "PasswordHistoryCount": 5,
    // Tự khóa màn hình — sau một khoảng không thao tác, màn hình khóa và phải nhập lại mật khẩu để làm tiếp.
    "SessionSettings": {
      // Khóa màn hình khi không thao tác (phút) — 0 = không tự khóa. Mở khóa cần thẻ làm mới còn hạn; hết hạn hoặc đã tắt thẻ làm mới thì phải đăng nhập lại từ đầu.
      "IdleTimeoutMinutes": 30
    },
    // Thẻ đăng nhập — thẻ ngắn hạn gửi kèm mỗi thao tác + thẻ làm mới dài hạn để tự xin thẻ ngắn hạn mới.
    "TokenSettings": {
      // Hạn thẻ ngắn hạn (phút) — hết hạn thì trình duyệt tự xin thẻ mới bằng thẻ làm mới; tắt thẻ làm mới thì đây là thời gian tối đa trước khi phải đăng nhập lại.
      "AccessTokenMinutes": 15,
      // Dùng thẻ làm mới — Bật: đăng nhập một lần dùng được nhiều ngày. Tắt: hết hạn thẻ ngắn hạn là phải đăng nhập lại (khi tắt nên nâng "Hạn thẻ ngắn hạn (phút)", vd 240).
      "RefreshEnabled": true,
      // Hạn thẻ làm mới khi không dùng (ngày) — mỗi lần làm mới được gia hạn thêm; bỏ không dùng quá số ngày này thì phải đăng nhập lại.
      "RefreshSlidingDays": 14,
      // Thời hạn tối đa của một lần đăng nhập (ngày) — quá hạn phải đăng nhập lại đủ bước (mật khẩu, OTP) dù dùng hằng ngày.
      "RefreshAbsoluteDays": 30,
      // Dung sai khi dùng lại thẻ cũ (giây) — thẻ cũ xuất hiện lại trong khoảng này được coi là hai tab cùng làm mới.
      // Quá khoảng này mà thẻ cũ còn được dùng thì coi là thẻ bị sao chép: đóng phiên ở mọi nơi. Đặt quá nhỏ dễ đẩy oan người mở nhiều tab.
      "ReuseGraceSeconds": 30,
      // Gắn thẻ làm mới với trình duyệt — Bật: thẻ chỉ dùng được trên đúng loại trình duyệt + hệ điều hành đã đăng nhập.
      "BindUserAgent": true,
      // Nơi trình duyệt giữ thẻ làm mới — Cookie (an toàn nhất, cần HTTPS) · Body (bộ nhớ trang, cho bản HTTP) · Auto (tự chọn).
      // Chọn Cookie trên máy chạy HTTP thì cookie không lưu được. Chế độ Linked phải đặt Cookie ở .env (AuthorizeSettings__TokenSettings__RefreshTransport).
      "RefreshTransport": "Auto",
      // Tên cookie thẻ làm mới — để trống: tự ghép từ tiền tố cookie của máy chủ (.env: Deployment__CookiePrefix).
      // Chỉ điền khi cần đặt NGUYÊN tên; hai phần mềm cùng tên sẽ đè cookie nhau. Đổi tên thì mọi người phải đăng nhập lại.
      "RefreshCookieName": "",
      // Email cảnh báo khi thẻ bị sao chép — Bật: gửi email cho chủ tài khoản khi thẻ làm mới bị dùng lại. Tắt: chỉ đóng phiên.
      // Thư chỉ đi khi đã khai tuyến email cho mục đích auth.session-alert và "Chế độ gửi" của nhóm Mã OTP không phải Fake.
      "NotifyOnReuse": true
    },
    // Mã OTP — mã dùng một lần gửi qua email / SMS: bước hai khi đăng nhập, quên mật khẩu, link đặt lại mật khẩu do quản trị gửi.
    // Tin chỉ đi được khi đã khai nhà cung cấp + tuyến gửi ở các màn gửi tin. Mã chỉ lưu dạng băm.
    "OtpSettings": {
      // Chế độ gửi — Live: gửi thật. Sandbox: gửi qua nhà cung cấp môi trường Thử nghiệm. Fake: không gửi gì, chỉ dùng khi phát triển.
      // Chỉ đổi khi triển khai; áp cho cả email cảnh báo. Production không nhận Fake — API không khởi động.
      "DeliveryMode": "Live",

      // Kênh gửi mã — Email hoặc Sms. Để trống = TẮT mã OTP: đăng nhập chỉ cần mật khẩu, quên mật khẩu và link đặt lại ngừng hoạt động.
      // Kênh Email cần tài khoản có email đã xác nhận; kênh Sms cần số điện thoại đã xác nhận.
      "DefaultChannel": "",

      // Mã cố định khi thử nghiệm — chỉ có tác dụng ở chế độ gửi Fake: mọi mã OTP đều bằng giá trị này. Để trống = mã ngẫu nhiên.
      // Máy chạy chính thức bắt buộc để trống (điền vào thì API không khởi động).
      "FixedCode": "",

      // Số chữ số của mã — từ 6 đến 10 (ngoài khoảng thì dùng 6).
      "CodeLength": 6,
      // Hiệu lực của mã (giây) — quá thời gian này mã hết dùng, phải xin mã mới. 0 hoặc số âm = 300 (5 phút).
      "LifetimeSeconds": 300,
      // Thời gian chờ gửi lại mã (giây) — sau một lần gửi phải chờ bấy nhiêu giây mới xin được mã mới. 0 = không chờ.
      "ResendCooldownSeconds": 60,
      // Số mã tối đa mỗi giờ cho một tài khoản — vượt thì từ chối gửi (chống gửi tràn, tốn tiền SMS). 0 = không giới hạn.
      "MaxSendPerHourPerUser": 5,
      // Số lần nhập sai mã tối đa — sai đủ số lần này thì mã bị hủy, phải xin mã mới. 0 = không giới hạn (dễ bị dò mã).
      "MaxVerifyAttempts": 5,
      // Ghi nhớ thiết bị (ngày) — chọn "Tin cậy thiết bị này" thì bấy nhiêu ngày khỏi nhập mã OTP trên thiết bị đó. 0 = tắt.
      "TrustedDeviceDays": 7,
      // Số thiết bị tin cậy tối đa mỗi tài khoản — thêm vượt số này thì thiết bị lâu không dùng nhất bị bỏ tin cậy.
      "MaxTrustedDevicesPerUser": 5,
      // Hạn link đặt lại mật khẩu (phút) — link quản trị gửi từ màn Tài khoản, dùng một lần. 0 hoặc số âm = theo "Hiệu lực của mã (giây)".
      "PasswordResetLinkLifetimeMinutes": 30,
      // Sau khi đặt lại mật khẩu: chỉ nhận ứng dụng / passkey (ngày) — trong số ngày này, bước 2 không nhận mã qua email / SMS. 0 = tắt.
      // Chỉ áp cho tài khoản đã có ứng dụng xác thực / passkey: chặn kẻ chiếm hộp thư tự đặt lại mật khẩu rồi lấy luôn mã đăng nhập.
      "StrongFactorOnlyDaysAfterReset": 7,
      // Tên hiển thị trong ứng dụng xác thực — tên mục hai lớp trong Authenticator. Để trống: tự theo môi trường (chính thức GeoVision, dev GeoVision_Dev).
      // Chỉ điền khi muốn tên riêng (không dấu hai chấm, tối đa 40 ký tự); chỉ áp cho mục cài mới.
      "TwoFactorIssuer": "",
      // Ngôn ngữ nội dung tin OTP — mã ngôn ngữ (vi, en…) chọn mẫu ở màn Mẫu thông báo; chưa có mẫu thì dùng lời văn mặc định.
      "TemplateLocale": "vi"
    },
    // Passkey — đăng nhập bước 2 bằng Windows Hello, vân tay, điện thoại hoặc khóa USB thay mã 6 số; người dùng tự thêm ở Tài khoản của tôi.
    // Chỉ dùng được khi giao diện mở bằng tên miền + HTTPS (hoặc localhost), không dùng được khi mở bằng địa chỉ IP.
    "PasskeySettings": {
      // Tên miền passkey — tên miền của giao diện, vd app.congty.vn (không https://, không cổng). Để trống = theo địa chỉ máy chủ đang được gọi.
      // Giao diện và API khác tên miền thì phải điền (.env: AuthorizeSettings__PasskeySettings__ServerDomain). Đổi sau khi có passkey thì passkey cũ hết dùng.
      "ServerDomain": "",
      // Số passkey tối đa mỗi tài khoản — chặn thêm quá số này.
      "MaxPerUser": 10
    },
    // reCAPTCHA chống máy dò — Google reCAPTCHA v3 chấm điểm mỗi lần đăng nhập, mở khóa màn hình, đổi / quên / đặt lại mật khẩu.
    // Cần cặp khóa tạo cho đúng tên miền. Khi bật, API phải gọi được tới Google, không thì mọi lần đăng nhập bị từ chối.
    "CaptchaSettings": {
      // Bật reCAPTCHA — Bật: kiểm tra mỗi lần đăng nhập và các thao tác trên. Tắt: bỏ qua kiểm tra.
      // Chỉ bật khi đã đặt đủ site key và secret key; thiếu khóa bí mật thì không ai đăng nhập được.
      "Enabled": true,
      // Khóa công khai (site key) — gửi xuống trình duyệt, không phải bí mật; phải cùng cặp với khóa bí mật.
      "SiteKey": "6LfMD4UtAAAAAImywma6tRYdSezLbte-wZqsvxsv",
      // Khóa bí mật (secret key) — chỉ đặt ở .env (AuthorizeSettings__CaptchaSettings__SecretKey); không hiện, không sửa ở màn này.
      "SecretKey": "ENV:AuthorizeSettings__CaptchaSettings__SecretKey",
      // Địa chỉ kiểm tra của Google — nơi máy chủ hỏi Google kết quả reCAPTCHA. Chỉ đổi khi triển khai: đổi sai là gửi khóa bí mật tới máy lạ.
      "VerifyUrl": "https://www.google.com/recaptcha/api/siteverify",
      // Điểm tối thiểu để cho qua — Google chấm 0.0 (gần như chắc là máy) đến 1.0 (gần như chắc là người); dưới điểm này thì từ chối.
      // Bắt đầu 0.5; đặt cao quá sẽ chặn oan người thật.
      "MinimumScore": 0.5,
      // Tên miền được phép — mỗi dòng một tên miền của trang giao diện; kết quả reCAPTCHA từ tên miền khác bị từ chối. Để trống = không kiểm.
      // Danh sách không có tên miền thật đang dùng thì mọi lần đăng nhập bị từ chối. Ở .env: AuthorizeSettings__CaptchaSettings__AllowedHostnames__0.
      "AllowedHostnames": [ "localhost" ]
    }
  }
}
