// Thông tin phần mềm — tên hệ thống, logo, biểu tượng tab, màu giao diện mặc định và email hỗ trợ hiện trên giao diện.
// Một bản ghi duy nhất cho mọi tên miền; ô để trống = mặc định của bản cài giao diện.
// Lưu xong có hiệu lực ngay, người dùng tải lại trang để thấy.
{
  // Bộ thông tin nhận diện — áp cho mọi tên miền; cũng sửa được ở màn Thông tin phần mềm.
  "Branding": {
    // Tên đầy đủ của hệ thống — hiện ở tiêu đề tab trình duyệt, thanh tiêu đề và màn đăng nhập. Tối đa 200 ký tự.
    "AppName": "Property Management System",
    // Tên ngắn — hiện cạnh logo ở đầu menu bên trái; để trống thì dùng tên đầy đủ. Tối đa 60 ký tự.
    "ShortName": "PMS",
    // Logo — đường dẫn ảnh trong hệ thống (bắt đầu bằng /) hoặc ảnh nhúng data:image/... (dưới ~300 KB). Để trống = logo mặc định.
    "LogoUrl": "",
    // Biểu tượng tab trình duyệt (favicon) — ảnh vuông nhỏ .ico hoặc .png, cùng luật như "Logo" (ảnh nhúng dưới ~80 KB).
    // Để trống = mặc định.
    "FaviconUrl": "",
    // Màu giao diện mặc định — indigo-light, teal-light, red-light, blue-dark,
    // green-dark hoặc pink-dark (-light nền sáng, -dark nền tối).
    // Để trống = màu mặc định. Người dùng đã tự chọn màu thì vẫn giữ lựa chọn của họ.
    "Skin": "",
    // Email hỗ trợ — hiện ở Bàn làm việc khi vai trò chưa được cấp chức năng nào; để trống thì không hiện. Tối đa 100 ký tự.
    "SupportEmail": ""
  }
}
