// Mức ghi nhật ký — mức thấp nhất ghi vào nhật ký kỹ thuật, theo nhóm nguồn. Hiệu lực ngay, không cần khởi động lại.
// Chỉ để GIẢM bớt (thấp hơn mức phần mềm đã cố định thì không ghi thêm). Ở .env: Logging__LogLevel__Default, được ưu tiên hơn tệp này.
{
  // Bộ lọc nhật ký — mức ghi theo từng nhóm nguồn.
  "Logging": {
    // Mức ghi theo nhóm nguồn — Trace < Debug < Information < Warning < Error < Critical < None (không ghi gì).
    "LogLevel": {
      // Mức mặc định — cho mọi nguồn không có ô riêng bên dưới. Máy chủ thật nên dùng Information hoặc Warning.
      "Default": "Debug",
      // Mức của .NET (System) — nhật ký nội bộ .NET. Phần mềm đã chỉ ghi từ Warning trở lên, nên chỉ Error, Critical, None mới bớt được.
      "System": "Information",
      // Mức của khung web và CSDL (Microsoft) — ASP.NET Core, Entity Framework; cũng như ô trên.
      "Microsoft": "Information"
    }
  }
}
