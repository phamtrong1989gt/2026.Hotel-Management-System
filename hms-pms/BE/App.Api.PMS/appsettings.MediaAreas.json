// Vùng phát tệp — thư mục trên máy chủ tệp mà trình duyệt được xem / tải qua API (/api/Media/<tên vùng>/<đường dẫn tệp>). Đổi phải khởi động lại API.
// Chỉ chạy khi đã khai File API ở .env (FileServer__BaseUrl), không thì mọi vùng trả "không tìm thấy".
// Danh sách CHO PHÉP: người xem chỉ chọn được TÊN VÙNG khai ở đây; địa chỉ máy chủ luôn lấy từ cấu hình.
{
  // Thiết lập vùng phát tệp — các vùng được phép phát.
  "MediaAreas": {
    // Danh sách vùng — tên mục là tên vùng trên địa chỉ. Thêm vùng: sửa thẳng tệp này rồi khởi động lại API.
    "Areas": {

      // Vùng "data" — ảnh phát ẨN DANH qua API (thư mục Flags: cờ ở danh mục Quốc tịch). ĐANG TẮT ở BDS / PMKT vì không cần cờ.
      // Tiền tố Data nay là GỐC KHO phần mềm: bật lại thì ai biết đường dẫn cũng xem được MỌI ảnh trong kho — phải thu hẹp về thư mục cờ trước, đừng chỉ bật ô «Bật».
      "data": {
        // Thư mục trên máy chủ tệp — đường dẫn (từ gốc máy chủ tệp) vùng này trỏ tới, vd /Data. Chỉ đổi khi triển khai; sai thì ảnh / video không hiện hoặc phát nhầm thư mục.
        "UpstreamPrefix": "/Data",
        // Thời gian trình duyệt nhớ tệp (giây) — 604800 = 7 ngày. 0 = không gửi chỉ dẫn này.
        "CacheSeconds": 604800,
        // Loại tệp được phát — mỗi dòng một đuôi có dấu chấm (vd .jpg); đuôi khác trả "không tìm thấy".
        // Để trống = phát MỌI loại tệp — không nên, vì thư mục có tệp do người dùng tải lên.
        "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp", ".ico" ],
        // Bật vùng này — Tắt: tạm ngừng phát mọi tệp của vùng mà không xóa khai báo.
        "Enabled": false
      }

      // Cố ý chưa khai vùng cho tài liệu và báo cáo xuất (nội dung tài liệu không kiểm soát được, báo cáo có thể chứa dữ liệu cá nhân).
      // Đừng thêm "cho tiện": tệp trong vùng phát ai có đường dẫn cũng mở được, KHÔNG cần đăng nhập.
    }
  }
}
