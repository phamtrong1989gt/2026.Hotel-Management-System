// Bảo mật đường truyền & khóa mã hóa — ép HTTPS, HSTS, cookie, header chuyển tiếp từ gateway, khóa RSA của kênh web quản trị.
// Tệp này bị khóa khỏi màn Cấu hình hệ thống, chỉ đổi khi triển khai.
// Ở .env dùng hai dấu gạch dưới cho cấp lồng (vd Security__HttpsMode=Require).
{
  // Khóa mã hóa kênh web quản trị — khóa riêng RSA chỉ đặt ở .env (Crypto__Admin__PrivateKey), cặp với khóa công khai trong bản build giao diện.
  // Khóa mã hóa cột bí mật trong CSDL (Crypto__PartnerKeyEncryptionKey) cũng chỉ ở .env. Đổi khóa RSA: docs/security/xoay-khoa-rsa.md, rồi khởi động lại API.
  "Crypto": {
    // Nhận diện khóa RSA — mã nhận diện (kid) nay tự suy ra từ chính khóa; hai ô dưới chỉ để tương thích bản giao diện cũ.
    "Admin": {
      // Tên cũ của khóa (kid) — để trình duyệt còn giữ bản giao diện cũ trong bộ nhớ đệm vẫn đăng nhập được. Không cần sửa.
      "Kid": "web-prod-2026-09",
      // Tên cũ của khóa trước — để trống, hầu như không dùng. Muốn tab đang mở chạy tiếp sau khi đổi khóa: đặt khóa trước ở .env (Crypto__Admin__PreviousPrivateKey).
      // Điền ô này mà thiếu khóa trước, hoặc trùng ô "Kid", thì API dừng khởi động.
      "PreviousKid": ""
    },
    // Thời gian nhớ khóa riêng của đối tác API (giây) — 0 = không nhớ: mỗi request đọc CSDL, thu hồi có hiệu lực tức thì ở mọi máy.
    // Lớn hơn 0: xoay / thu hồi khóa chỉ có hiệu lực ngay trên máy thực hiện, máy khác trễ tối đa bằng số này.
    "PartnerKeyCacheSeconds": 60,
    // Chính sách khi dùng khóa RSA mặc định của kho mã (dùng chung nhiều dự án) — Warn: vẫn chạy, chỉ nhắc. Strict: API KHÔNG khởi động.
    // Dự án thật nên đặt Strict (.env: Crypto__RepoDefaultKeyPolicy=Strict) sau khi sinh khóa riêng; máy Development không bị chạm tới.
    "RepoDefaultKeyPolicy": "Warn"
  },

  // Bảo mật đường truyền — ép HTTPS, HSTS, cookie và tin header chuyển tiếp của gateway. Ô để null = tự dò; điền giá trị = ép tay.
  // Chỉ tự dò NĂNG LỰC, không tự quyết CHÍNH SÁCH (kẻ cắt TLS sẽ khiến app tự hạ cấp theo) — nên máy chủ thật phải khai thẳng Require.
  "Security": {

    // Chế độ HTTPS — Auto: tự dò (Development không ép; thấy cổng HTTPS thì ép). Require: ép HTTPS. Off: chấp nhận HTTP. Ở .env: Security__HttpsMode.
    // Require mà không dò được cổng HTTPS thì API KHÔNG khởi động (cố ý, khỏi lặng lẽ chạy HTTP).
    "HttpsMode": "Auto",

    // Cổng HTTPS — null: dò từ biến ASPNETCORE_HTTPS_PORT (IIS tự đặt), không có thì 443. Điền số khi IIS nghe HTTPS ở cổng khác.
    "HttpsPort": null,

    // HSTS — bảo trình duyệt nhớ rằng tên miền này chỉ dùng HTTPS (mặc định chỉ bật khi Require).
    "Hsts": {
      // Bật HSTS — null: theo chế độ HTTPS; điền true / false để ép.
      // Trình duyệt GHI NHỚ HSTS theo tên miền: bật nhầm lúc HTTPS chưa ổn định thì người dùng bị chặn, xóa cache cũng không gỡ được.
      "Enabled": null,
      // Thời gian trình duyệt nhớ HSTS (ngày).
      "MaxAgeDays": 365,
      // Áp cho cả tên miền con — bật thì MỌI tên miền con cũng bị ép HTTPS; kiểm hết trước khi bật.
      "IncludeSubDomains": false,
      // Đưa vào danh sách nạp sẵn của trình duyệt — gỡ ra mất HÀNG THÁNG; chỉ bật khi chắc mọi tên miền (kể cả con) chạy HTTPS vĩnh viễn.
      "Preload": false
    },

    // Cookie bảo mật — cờ Secure và SameSite của cookie do phần mềm đặt (thẻ làm mới, thiết bị tin cậy); null = theo chế độ HTTPS.
    "Cookie": {
      // Cờ Secure của cookie — null: theo chế độ (Require thì Secure).
      // Trình duyệt TỪ CHỐI LƯU cookie Secure khi trang chạy HTTP: ép true trên bản HTTP thì thiết bị tin cậy không bao giờ được lưu.
      "Secure": null,

      // Cờ SameSite của cookie — null: theo chế độ (Require thì None để giao diện khác origin gửi được, ngược lại Lax). Hợp lệ: None · Lax · Strict.
      // SameSite=None BẮT BUỘC đi kèm Secure, không thì trình duyệt loại; trên HTTP giao diện khác origin không gửi cookie.
      "SameSite": null
    },

    // Header chuyển tiếp — tin X-Forwarded-* do gateway / proxy gửi (IP thật của người gọi, http hay https, tên miền công khai). Tắt mặc định.
    // SAI Ở ĐÂY = GIẢ MẠO IP ("IP khách" tự chọn, né giới hạn tần suất): chỉ khai ĐÚNG IP của gateway, đừng khai dải rộng. Bật mà khai thiếu / sai thì API KHÔNG KHỞI ĐỘNG.
    "ForwardedHeaders": {
      // Bật — công tắc tổng. Tắt (mặc định): bỏ qua X-Forwarded-*, các ô dưới không được đọc. Bật: phải khai ít nhất một nguồn tin cậy.
      // Ở .env: Security__ForwardedHeaders__Enabled=true và Security__ForwardedHeaders__KnownProxies__0=10.0.5.20 (mảng đánh số từ 0).
      "Enabled": false,

      // Số bước proxy — số địa chỉ tối đa đọc từ cuối X-Forwarded-For (1 đến 5); 1 = đúng một gateway đứng trước API. Chỉ tăng khi có chuỗi nhiều proxy đều được tin.
      "ForwardLimit": 1,

      // Địa chỉ proxy tin cậy — IP của gateway / proxy kết nối TRỰC TIẾP tới API; chỉ header từ các địa chỉ này được tin.
      // Ví dụ gateway cùng máy (dev): ["127.0.0.1", "::1"]; máy riêng: ["10.0.5.20"]. Rỗng (cùng "Dải proxy tin cậy") mà đang bật thì API không khởi động.
      "KnownProxies": [],

      // Dải proxy tin cậy — danh sách dải CIDR (vd "10.0.5.0/24") khi có nhiều gateway cùng dải mạng; đừng khai rộng hơn mạng của gateway.
      "KnownNetworks": [],

      // Header được tin — XForwardedFor (IP khách) · XForwardedProto (http / https) · XForwardedHost (tên miền công khai). Rỗng = cả ba.
      "Headers": []
    }
  }
}
