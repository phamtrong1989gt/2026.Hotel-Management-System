<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config NGUỒN của App.Api.PMS (2026-10-06, đợt 6 chốt bản — review R7-M6). CHỈ khai phần IIS mà ứng dụng không tự làm được.

  · Khi `dotnet publish`, Web SDK đọc tệp này rồi TỰ THÊM <handlers> (AspNetCoreModuleV2) + <aspNetCore> (processPath, arguments,
    hostingModel="outofprocess" theo App.Api.PMS.csproj) vào đúng <location> dưới đây. ĐỪNG tự khai hai phần đó ở đây: chạy IIS Express
    trên máy dev, Visual Studio đã khai handler ở applicationhost.config của site → khai thêm ở đây là "trùng mục" (IIS 500.19).
  · requestLimits: IIS mặc định chặn thân request > 30.000.000 byte (~28,6 MB) và trả 404.13 TRƯỚC khi tới ứng dụng — dev chạy
    Kestrel / IIS Express không tái hiện được. Trần TỆP của ứng dụng là 100 MB; trần THÂN YÊU CẦU = 100 MB + 1 MB biên multipart
    (ranh giới, tiêu đề từng phần, ô form) = 105906176 byte (review 2026-10-07 vòng 3 m-5 — bản cũ đặt đúng 100 MB nên tệp sát 100 MB
    bị 404.13 / 413 thay vì tải được). Số này = UploadFileRules.MaxRequestBytes (PTCore.Modules.FileStorage), dùng chung ở:
      Program.cs (Kestrel MaxRequestBodySize) · Composition/InfrastructureServiceExtensions.cs (MultipartBodyLengthLimit) ·
      App.Modules.PMS DocumentController.Upload [RequestSizeLimit] (tải tài liệu trực tiếp — đường tải lớn nhất).
    Video đi đường tải theo khúc (mỗi khúc ≤ 10 MB) nên không cần nới thêm. Đổi trần ở mã thì sửa CÙNG LÚC số dưới đây (có test so
    tệp này với UploadFileRules.MaxRequestBytes) — đặt lớn hơn trần ứng dụng không mua thêm được gì (ứng dụng vẫn từ chối 413) mà chỉ
    mở rộng bề mặt gửi thân request lớn vào máy chủ.
  · Gỡ header lộ nền tảng (kế hoạch an ninh A06-07, 2026-10-22): `removeServerHeader="true"` bỏ "Server: Microsoft-IIS/…" và `<remove name="X-Powered-By"/>` bỏ
    "X-Powered-By: ASP.NET" (IIS đặt mặc định ở applicationHost). `removeServerHeader` cần IIS 10+ (Windows Server 2016+); IIS cũ hơn báo lỗi cấu hình 500.19 — khi đó
    bỏ thuộc tính và dùng URL Rewrite outbound rule. Máy quét `scripts/security/scan-publish.mjs` luật F4 kiểm hai dòng này trên web.config đã publish.
  · Kiểm sau publish: mở web.config trong thư mục publish → phải thấy cả AspNetCoreModuleV2 lẫn maxAllowedContentLength="105906176" lẫn removeServerHeader="true".
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 101 MB = 105906176 byte = trần tệp 100 MB + 1 MB biên multipart — khớp trần thân yêu cầu của ứng dụng (xem ghi chú đầu tệp). -->
          <requestLimits maxAllowedContentLength="105906176" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
