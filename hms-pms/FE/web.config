<?xml version="1.0" encoding="utf-8"?>
    <configuration>
      <system.webServer>
        <rewrite>
          <rules>
            <!-- "/" là thư mục nên luật SPA bên dưới không áp → đi tài liệu mặc định; viết lại tường minh để location index.html
                 (không cache) chắc chắn được áp cho trang gốc. -->
            <rule name="Root to index" stopProcessing="true">
              <match url="^$" />
              <action type="Rewrite" url="/index.html" />
            </rule>
            <rule name="AngularJS Routes" stopProcessing="true">
              <match url=".*" />
              <conditions logicalGrouping="MatchAll">
                <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />   
              </conditions>
              <action type="Rewrite" url="/index.html" />
            </rule>
          </rules>
        </rewrite>
		
		 <staticContent>
      <clientCache cacheControlCustom="public" cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
	  <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
            <mimeMap fileExtension=".mkv" mimeType="video/x-matroska" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>

      <!-- ── Nén tệp tĩnh (gzip) ──────────────────────────────────────────────────────────────────────
           Bundle JS/CSS + tệp dịch .json + index.html nén gzip giảm ~70% băng thông tải lần đầu. CHỈ bật phần TĨNH: site này chỉ phát
           tệp build (mọi cuộc gọi dữ liệu đi sang API ở origin khác) nên nén động vô nghĩa. Dòng này chỉ có tác dụng khi máy chủ ĐÃ CÀI
           tính năng IIS "Static Content Compression" (Web-Stat-Compression — runbook triển khai 1.1); thiếu mô-đun thì IIS bỏ qua, không
           báo lỗi, và tệp vẫn phát nguyên dạng. Danh sách kiểu MIME được nén (httpCompression) KHÔNG đặt được trong web.config — nằm ở
           applicationHost, mặc định đã gồm text/*, JavaScript và JSON. -->
      <urlCompression doStaticCompression="true" doDynamicCompression="false" />

      <!-- ── Security headers ──────────────────────────────────────────────
           CSP CHẶN THẬT từ 6.0.0 (coder chốt 2026-10-12; trước đó Report-Only). Chuỗi do scripts/web-config-build.mjs dựng từ
           environment.prod.ts — đừng sửa tay giá trị ở đây. `ng serve` cấu hình development vẫn Report-Only; cấu hình agent · linked chặn thật như bản này (xem angular.json).
           Nguồn ngoài đã whitelist theo quét thực tế: reCAPTCHA · API · bản đồ tự cài (khi điền vnmap.server trong environment). Chatbot và Google Maps không dùng;
           font icon Material đã tự cài trong bản build nên bỏ Google Fonts.
           Bật đăng nhập một lần (SSO): giao diện tự gọi hệ thống danh tính → thêm origin vào `cspExtraConnectSrc` của environment.prod.ts rồi build
           lại; máy đang chạy cần gấp thì thêm origin đó vào cuối mục connect-src của web.config ĐÃ triển khai (lần triển khai sau sẽ ghi đè — phải sửa
           environment.prod.ts). Thiếu thì nút SSO báo "Không kết nối được hệ thống danh tính".

           ⚠️ ĐỪNG HỨA LỐ về việc bật enforce sẽ chặn XSS: script-src còn 'unsafe-inline' nên script
           chèn vào DOM VẪN CHẠY. Thứ enforce mua được (GIẢM THIỆT HẠI, không phải chặn xâm nhập): chặn
           fetch / XHR / WebSocket tới máy lạ (connect-src), khung lạ (frame-src), plugin (object-src), đổi
           <base> (base-uri), gửi form ra ngoài (form-action — rv10 R9), bị nhúng (frame-ancestors).
           KHÔNG chặn được lấy dữ liệu qua ẢNH (img-src còn 'https:' — ảnh bản đồ / landing / ảnh ngoài) hay
           điều hướng trang khi script chèn được đã chạy. Muốn chặn thi hành thì phải bỏ 'unsafe-inline' và
           chuyển sang nonce/hash — việc riêng, lớn hơn.

           media-src: THÊM ở cycle 11.31. Trước đó KHÔNG khai nên rơi về default-src 'self' ⇒ bật
           enforce là chặn sạch video sự cố (mediaBasePath = serverAPI) lẫn preview blob: từ
           createObjectURL. Report-only không lộ ra lỗi này nếu người kiểm không mở đúng màn video.

           ĐÃ BIẾT, KHÔNG whitelist: dashboard mở ws://localhost:9999 + http://localhost:9999/hls/*.m3u8
           (baseSteamServerUrl). Coder xác nhận là cấu hình SÓT LẠI, và tính năng vốn đã không chạy
           (videoUrl khai rồi không gán ở đâu) ⇒ để CSP chặn là đúng, đừng mở cổng cho mã chết.
           Cùng lý do (6.0.0): iframe màn Báo cáo {baseReportUrl}/Home/Viewer — máy chủ báo cáo không có trong kho, API không phục vụ đường
           này, màn không có trong menu seed ⇒ frame-src KHÔNG mở cho origin báo cáo. -->
      <!-- Gỡ header lộ nền tảng / phiên bản (máy quét an ninh bản phát hành, luật F4): "Server: Microsoft-IIS/…" và "X-Powered-By: ASP.NET".
           removeServerHeader cần IIS 10+ (Windows Server 2016+); IIS cũ hơn báo lỗi cấu hình 500.19 — khi đó bỏ thuộc tính và dùng URL Rewrite outbound rule. -->
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Site giao diện phát TĨNH: tệp lưu trữ / sao lưu / khoá bỏ nhầm vào thư mục site sẽ tải được qua HTTP. Chặn theo đuôi (IIS trả 404.7) —
               máy quét an ninh bản phát hành (luật F3) kiểm khối này. allowUnlisted="true": đuôi không liệt kê (js, css,
               json, font, ảnh...) vẫn phát bình thường. Thêm đuôi ở ĐÂY (tệp gốc), đừng sửa src/web.config sinh ra. -->
          <fileExtensions allowUnlisted="true">
            <add fileExtension=".rar" allowed="false" />
            <add fileExtension=".zip" allowed="false" />
            <add fileExtension=".7z" allowed="false" />
            <add fileExtension=".tar" allowed="false" />
            <add fileExtension=".bak" allowed="false" />
            <add fileExtension=".old" allowed="false" />
            <add fileExtension=".sql" allowed="false" />
            <add fileExtension=".env" allowed="false" />
            <add fileExtension=".pfx" allowed="false" />
            <add fileExtension=".pem" allowed="false" />
            <add fileExtension=".key" allowed="false" />
            <add fileExtension=".log" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https://api.pms.invalid; connect-src 'self' https://api.pms.invalid wss://api.pms.invalid https://www.google.com/recaptcha/; worker-src 'self' blob:; frame-src 'self' https://www.google.com/recaptcha/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
          <!-- HSTS 1 năm, KHÔNG includeSubDomains / preload (chốt theo kế hoạch an ninh); trình duyệt bỏ qua tiêu đề này trên http. Permissions-Policy: tắt camera / micro / thanh toán / USB (ứng dụng không dùng; vị trí địa lý để mặc định vì bản đồ có thể dùng). -->
          <add name="Strict-Transport-Security" value="max-age=31536000" />
          <add name="Permissions-Policy" value="camera=(), microphone=(), payment=(), usb=()" />
        </customHeaders>
      </httpProtocol>

      </system.webServer>

      <!-- ── Không cache các tệp KHÔNG có hash trong tên (review 2026-10-06 R6-M1) ─────────────────────────
           clientCache 365 ngày ở trên chỉ đúng cho bundle JS/CSS có hash (đổi nội dung = đổi tên). index.html và tệp dịch giữ NGUYÊN tên
           qua mọi lần triển khai: cache 1 năm nghĩa là từ lần triển khai thứ 2 trình duyệt vẫn dùng index.html cũ → gọi chunk cũ đã xoá
           (trang trắng / ChunkLoadError), nhãn mới hiện khoá thô. DisableCache = trình duyệt luôn hỏi lại (304 khi không đổi — rẻ).
           Luật SPA ở trên viết lại về "/index.html" (không "/") để chắc chắn location index.html được áp cho mọi route.
           Kiểm sau triển khai: curl -sI / , /manage/x , /assets/i18n/vi.json → Cache-Control: no-cache; main-*.js → max-age=31536000. -->
      <location path="index.html">
        <system.webServer>
          <staticContent>
            <clientCache cacheControlMode="DisableCache" cacheControlCustom="" />
          </staticContent>
        </system.webServer>
      </location>
      <location path="assets/i18n">
        <system.webServer>
          <staticContent>
            <clientCache cacheControlMode="DisableCache" cacheControlCustom="" />
          </staticContent>
        </system.webServer>
      </location>
      <location path="assets/i18n-platform">
        <system.webServer>
          <staticContent>
            <clientCache cacheControlMode="DisableCache" cacheControlCustom="" />
          </staticContent>
        </system.webServer>
      </location>
    </configuration>
